rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ONLY trusted Firebase custom claim 'admin: true' grants admin privileges
    // Hardcoded email fallbacks are strictly prohibited
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isActiveSeller() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/seller_profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/seller_profiles/$(request.auth.uid)).data.status == 'active';
    }

    // Helpers: Validate Seller Profile creation & owner updates
    function isValidSellerTimeField(val) {
      return (val is string && val.size() <= 50) || val is timestamp;
    }

    function isValidSellerEditableFields(data) {
      return (!('storeName' in data) || (data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 100))
        && (!('slug' in data) || (data.slug is string && data.slug.size() <= 120 && data.slug.matches('^[a-z0-9-]*$')))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('profileImage' in data) || (data.profileImage is string && data.profileImage.size() <= 1000 && !data.profileImage.matches('(?is)^\\s*data:.*')))
        && (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 30))
        && (!('showWhatsapp' in data) || data.showWhatsapp is bool)
        && (!('updatedAt' in data) || isValidSellerTimeField(data.updatedAt));
    }

    function isValidSellerProfileCreate(sellerId) {
      let data = request.resource.data;
      let keys = data.keys();
      return keys.hasAll(['sellerId', 'storeName', 'status', 'isVerified'])
        && keys.hasOnly([
          'id', 'sellerId', 'storeName', 'slug', 'email', 'phone', 'bio',
          'category', 'profileImage', 'whatsappNumber', 'showWhatsapp',
          'status', 'isVerified', 'appliedAt', 'createdAt', 'updatedAt'
        ])
        && data.sellerId == sellerId
        && (!('id' in data) || data.id == sellerId)
        && data.isVerified == false
        && data.status == 'pending'
        && data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 100
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('appliedAt' in data) || isValidSellerTimeField(data.appliedAt))
        && (!('createdAt' in data) || isValidSellerTimeField(data.createdAt))
        && isValidSellerEditableFields(data);
    }

    function isValidSellerProfileUpdate(sellerId) {
      let data = request.resource.data;
      let prev = resource.data;
      let affected = data.diff(prev).affectedKeys();
      return data.sellerId == sellerId
        && data.sellerId == prev.sellerId
        && data.status == prev.status
        && data.isVerified == prev.isVerified
        && affected.hasOnly([
          'storeName', 'slug', 'phone', 'bio', 'category',
          'profileImage', 'whatsappNumber', 'showWhatsapp', 'updatedAt'
        ])
        && (!('storeName' in affected) || ('storeName' in data))
        && isValidSellerEditableFields(data);
    }

    // Helper: Validate Customer Enquiry creation
    function isValidEnquiryCreate() {
      let data = request.resource.data;
      
      // 1. Required keys presence
      let hasRequiredKeys = data.keys().hasAll([
        'customerId', 'sellerId', 'productId', 'productTitle', 'status', 'createdAt'
      ]);
      
      // 2. Strict allowlist - unexpected fields are rejected
      // Note: adminNotes is strictly prohibited from the enquiry document
      let hasOnlyAllowedKeys = data.keys().hasOnly([
        'customerId', 'sellerId', 'productId', 'productTitle', 'price',
        'customerName', 'customerEmail', 'customerPhone', 
        'creationType', 'colorPalette', 'deadline', 'details', 'customInstructions', 
        'referenceImages', 'status', 'createdAt'
      ]);
      
      // 3. Required fields type and length validation
      let validRequiredFields = 
        data.customerId == request.auth.uid
        && data.sellerId is string && data.sellerId.size() > 0 && data.sellerId.size() <= 128
        && data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128
        && data.productTitle is string && data.productTitle.size() > 0 && data.productTitle.size() <= 200
        && data.status == 'new'
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50;
      
      // 4. Optional fields validation when present
      let validOptionalFields = 
        (!('price' in data) || (data.price is number && data.price >= 0))
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 100))
        && (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 150))
        && (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 50))
        && (!('creationType' in data) || (data.creationType is string && data.creationType.size() <= 100))
        && (!('colorPalette' in data) || (data.colorPalette is string && data.colorPalette.size() <= 200))
        && (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 100))
        && (!('details' in data) || (data.details is string && data.details.size() <= 2000))
        && (!('customInstructions' in data) || (data.customInstructions is string && data.customInstructions.size() <= 2000));

      // 5. Reference images validation (count <= 5, each item must be a valid string <= 1000 chars)
      let validReferenceImages = !('referenceImages' in data) || (
        data.referenceImages is list
        && data.referenceImages.size() <= 5
        && (data.referenceImages.size() == 0 || (data.referenceImages[0] is string && data.referenceImages[0].size() <= 1000))
        && (data.referenceImages.size() <= 1 || (data.referenceImages[1] is string && data.referenceImages[1].size() <= 1000))
        && (data.referenceImages.size() <= 2 || (data.referenceImages[2] is string && data.referenceImages[2].size() <= 1000))
        && (data.referenceImages.size() <= 3 || (data.referenceImages[3] is string && data.referenceImages[3].size() <= 1000))
        && (data.referenceImages.size() <= 4 || (data.referenceImages[4] is string && data.referenceImages[4].size() <= 1000))
      );

      // 6. Seller existence and active status verification
      let sellerValid = exists(/databases/$(database)/documents/seller_profiles/$(data.sellerId))
        && get(/databases/$(database)/documents/seller_profiles/$(data.sellerId)).data.status == 'active';

      // 7. Product existence, approved status, and seller ownership cross-check
      let productValid = exists(/databases/$(database)/documents/products/$(data.productId))
        && get(/databases/$(database)/documents/products/$(data.productId)).data.status == 'approved'
        && get(/databases/$(database)/documents/products/$(data.productId)).data.sellerId == data.sellerId;

      return hasRequiredKeys 
        && hasOnlyAllowedKeys 
        && validRequiredFields 
        && validOptionalFields 
        && validReferenceImages
        && sellerValid 
        && productValid;
    }

    // Helper: Validate a single compact wishlist item map produced by WishlistContext
    function isValidWishlistItemMap(item) {
      let keys = item.keys();
      let orig = item.get('originalPrice', null);
      let badge = item.get('badge', '');
      let desc = item.get('description', '');
      let mat = item.get('materials', '');
      let dim = item.get('dimensions', '');

      return keys.hasAll([
          'id', 'name', 'price', 'image', 'categoryName', 'addedAt'
        ])
        && keys.hasOnly([
          'id', 'name', 'price', 'image', 'categoryName', 'addedAt',
          'originalPrice', 'badge', 'description', 'materials', 'dimensions'
        ])
        && item.id is string
        && item.id.size() >= 1 && item.id.size() <= 128
        && !item.id.matches('(?s).*/.*')
        && !(item.id in ['__proto__', 'constructor', 'prototype'])
        && item.name is string && item.name.size() >= 1 && item.name.size() <= 200
        && item.price is number && item.price >= 0
        && item.image is string && item.image.size() <= 1000 && !item.image.matches('(?is)^\\s*data:.*')
        && item.categoryName is string && item.categoryName.size() <= 100
        && item.addedAt is string && item.addedAt.size() >= 1 && item.addedAt.size() <= 50
        && (orig == null || (orig is number && orig >= 0))
        && (badge is string && badge.size() <= 60)
        && (desc is string && desc.size() <= 1000)
        && (mat is string && mat.size() <= 300)
        && (dim is string && dim.size() <= 150);
    }

    function isValidWishlistItem(item) {
      return item is map && isValidWishlistItemMap(item);
    }

    function isValidWishlistTopLevel(data, maxItems) {
      let keys = data.keys();
      return keys.hasAll(['items', 'updatedAt'])
        && keys.hasOnly(['items', 'updatedAt'])
        && data.items is map
        && data.items.size() <= maxItems
        && data.updatedAt == request.time;
    }

    // Validate single-item map entry via List indexing on values() + Set key match (valid Rules v2)
    function isValidSingleWishlistCreateItem(itemsMap) {
      let item = itemsMap.values()[0];
      return isValidWishlistItem(item)
        && itemsMap.keys().hasOnly([item.id])
        && (item.id in itemsMap)
        && itemsMap[item.id] == item;
    }

    function isValidWishlistCreate() {
      let data = request.resource.data;
      return isValidWishlistTopLevel(data, 1)
        && (data.items.size() == 0 || isValidSingleWishlistCreateItem(data.items));
    }

    function isValidWishlistChangedItems(nextItems, prevItems) {
      let diff = nextItems.diff(prevItems);
      let addedKeys = diff.addedKeys();
      let changedKeys = diff.changedKeys();
      let removedKeys = diff.removedKeys();
      let addedOrChanged = addedKeys.union(changedKeys);

      return (
        addedOrChanged.size() == 1
        && removedKeys.size() == 0
      ) || (
        addedKeys.size() == 0
        && changedKeys.size() == 0
        && removedKeys.size() == 1
      );
    }

    function isValidWishlistUpdate() {
      let data = request.resource.data;
      let prev = resource.data;
      let hasPrevItems = ('items' in prev) && (prev.items is map);
      return isValidWishlistTopLevel(data, 100)
        && data.diff(prev).affectedKeys().hasOnly(['items', 'updatedAt'])
        && (
          (hasPrevItems && isValidWishlistChangedItems(data.items, prev.items))
          || (!hasPrevItems && data.items.size() <= 1 && (data.items.size() == 0 || isValidSingleWishlistCreateItem(data.items)))
        );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isOwner(userId) && request.resource.data.role in ['customer', 'seller'];
      allow update: if isAuthenticated() && (
        (isOwner(userId) && !('role' in request.resource.data.diff(resource.data).affectedKeys())) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Seller profiles collection (strictly private PII; owner or admin read only)
    match /seller_profiles/{sellerId} {
      // Only profile owner or admin may read directly (protects email, phone, whatsappNumber, adminNotes)
      // Cross-document exists()/get() checks in Rules (e.g. isActiveSeller(), isValidEnquiryCreate()) bypass read rules
      allow read: if isOwner(sellerId) || isAdmin();
      
      // Open seller registration: owner creates own pending/unverified profile with strict schema validation
      allow create: if isAdmin() || (isOwner(sellerId) && isValidSellerProfileCreate(sellerId));
      
      // Seller can update allowed profile fields only; sellerId, status, isVerified, email, id, adminNotes remain immutable
      allow update: if isAdmin() || (isOwner(sellerId) && resource != null && isValidSellerProfileUpdate(sellerId));
      allow delete: if isAdmin();
    }

    // Products collection
    match /products/{productId} {
      // Public visitors can only view approved products (under approvalStatus or legacy status schema);
      // creators view their own drafts/pending/rejected; admin views all
      allow read: if (resource != null && (resource.data.get('approvalStatus', null) == 'approved' || (!('approvalStatus' in resource.data) && resource.data.get('status', null) == 'approved')))
                  || (isAuthenticated() && ((resource != null && resource.data.get('sellerId', null) == request.auth.uid) || isAdmin()));
      
      // Only active sellers can create drafts or submit for review (never self-approve, feature, or add moderation fields)
      allow create: if isAdmin() || (
        isActiveSeller()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.approvalStatus in ['draft', 'pending']
        && (!('status' in request.resource.data) || request.resource.data.status in ['available', 'sold_out'])
        && (!('isFeatured' in request.resource.data) || request.resource.data.isFeatured == false)
        && !('moderationNotes' in request.resource.data)
        && !('moderatedAt' in request.resource.data)
      );
      
      // Active sellers can edit their own products into draft/pending; cannot change ownership, self-approve, or alter moderation/featured fields
      // Only admins can approve, reject, feature, or edit any product
      allow update: if isAdmin() || (
        isActiveSeller()
        && resource != null
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.approvalStatus in ['draft', 'pending']
        && (!('status' in request.resource.data) || request.resource.data.status in ['available', 'sold_out'])
        && !('isFeatured' in request.resource.data.diff(resource.data).affectedKeys())
        && !('moderationNotes' in request.resource.data.diff(resource.data).affectedKeys())
        && !('moderatedAt' in request.resource.data.diff(resource.data).affectedKeys())
      );
      
      // Only an active product owner or admin can delete
      allow delete: if isAdmin() || (isActiveSeller() && resource != null && resource.data.sellerId == request.auth.uid);
    }

    // Categories collection (public read, admin write)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Enquiries collection (Public / Customer / Seller data)
    // adminNotes is strictly forbidden here to protect administrative privacy
    match /enquiries/{enquiryId} {
      // Authenticated customer creates enquiry with comprehensive cross-document verification
      allow create: if isAuthenticated() && isValidEnquiryCreate();
      
      // Enquiry can only be read by the customer who submitted it, the targeted seller, or admin
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      
      // Customers cannot alter an enquiry once submitted.
      // Target seller can only update status, sellerNotes, and updatedAt timestamp.
      // A seller must NEVER create, modify, or delete adminNotes.
      // Customer details, product details, sellerId, and price are completely immutable.
      allow update: if isAuthenticated() && (
        (resource.data.sellerId == request.auth.uid 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sellerNotes', 'updatedAt'])
          && request.resource.data.status in ['new', 'contacted', 'in_discussion', 'in_progress', 'completed', 'cancelled', 'archived']
          && (!('sellerNotes' in request.resource.data) || (request.resource.data.sellerNotes is string && request.resource.data.sellerNotes.size() <= 2000))
          && (!('updatedAt' in request.resource.data) || (request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 50))
        ) ||
        isAdmin()
      );
      
      // Only admin can delete an enquiry
      allow delete: if isAdmin();
    }

    // Dedicated Admin-Only Enquiry Notes (Completely isolated from customers and sellers)
    match /admin_enquiry_notes/{enquiryId} {
      // Only trusted administrators with admin custom claim have read or write access
      allow read, write: if isAdmin();
    }

    // Fashion Portfolio & Art Gallery (public read, admin write)
    match /fashion_portfolio/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /art_gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Platform settings (public read, admin write)
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Assumed Data Model — Collection: wishlists / Document ID: {userId}
    // Strictly private cross-browser customer wishlists (owner-only; no public, cross-user, or admin access)
    // Fields:
    //   - items: map (required; size <= 1 on create, size <= 100 on update with 1 add/modify or 1 removal per write)
    //     Each entry maps productId -> compact item map:
    //       required: id (string 1..128, no '/', not '__proto__'/'constructor'/'prototype', matches map key),
    //                 name (string 1..200), price (number >= 0),
    //                 image (string <= 1000, not data: URI), categoryName (string <= 100), addedAt (string 1..50)
    //       optional: originalPrice (null or number >= 0), badge (string <= 60),
    //                 description (string <= 1000), materials (string <= 300), dimensions (string <= 150)
    //   - updatedAt: timestamp (required, must equal request.time)
    match /wishlists/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidWishlistCreate();
      allow update: if isOwner(userId) && isValidWishlistUpdate();
    }
  }
}
