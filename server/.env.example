# Petal & Thread - Backend Environment Variables (Express API)
PORT=5000
NODE_ENV=development

# JWT Secret for legacy fallback sessions
JWT_SECRET=petal_and_thread_atelier_secret_jwt_key_2026

# Cloudinary Server Credentials (NEVER expose to frontend!)
# Required for server-signed direct client uploads and asset cleanup
CLOUDINARY_CLOUD_NAME=petal-and-thread
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Firebase Admin SDK Configuration
# Path to service account JSON (resolved automatically relative to server/config or absolute path)
# Required for running setAdminRole.js, seedFirstSeller.js, and live migrateLegacyData.js
GOOGLE_APPLICATION_CREDENTIALS=./config/serviceAccountKey.json
FIREBASE_PROJECT_ID=petal-and-thread
