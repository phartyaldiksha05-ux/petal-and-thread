# Petal & Thread - Frontend Environment Variables (Vite)
# Copy this file to .env and populate with your project credentials.

VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
VITE_FIREBASE_AUTH_DOMAIN=petal-and-thread.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=petal-and-thread
VITE_FIREBASE_STORAGE_BUCKET=petal-and-thread.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Cloudinary Cloud Name (Public identifier only — upload signatures generated server-side)
VITE_CLOUDINARY_CLOUD_NAME=petal-and-thread

# Backend Atelier Express API URL
VITE_API_URL=http://localhost:5000/api
